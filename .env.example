# Public URL of the deployed site (used by the contact form on the client).
# Local dev:   http://localhost:3000
# Production:  https://www.ramkrit.in
NEXT_PUBLIC_APP_URL =

# Google Tag Manager ID (optional)
NEXT_PUBLIC_GTM =

# Gmail SMTP (used to send messages from the contact form)
EMAIL_ADDRESS =
GMAIL_PASSKEY =

# Optional: comma-separated list of recipient emails for the contact form.
# Falls back to EMAIL_ADDRESS if empty.
# Example: RECIPIENT_EMAILS=you@example.com,backup@example.com
RECIPIENT_EMAILS =

# Telegram (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =
